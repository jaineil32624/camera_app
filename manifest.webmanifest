{
  "name": "Camera App — Colorful Pose & Speech Recorder",
  "short_name": "Camera App",
  "description": "A colorful camera with live filters, timer, burst, grid, zoom, video recording, an offline gallery and AI pose + speech sessions.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0c0f1b",
  "theme_color": "#0c0f1b",
  "categories": ["photo", "utilities", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Video", "url": "./index.html?mode=video" },
    { "name": "AI Session", "url": "./index.html?mode=session" }
  ]
}
